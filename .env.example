# AI Gateway auth uses OIDC by default — `vercel env pull .env.local`
# provisions VERCEL_OIDC_TOKEN automatically (short-lived, auto-refreshed
# in production). No manual gateway key required for local dev or production.

# Upstash Redis (auto-injected if provisioned via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
